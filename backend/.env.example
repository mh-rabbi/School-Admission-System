# Environment for running the API directly with `dotnet run` (outside Docker).
# `docker compose` reads the root .env instead — see ../.env.example.
# In Development, appsettings.Development.json already points at the compose database on localhost:5432.

ConnectionStrings__Default=Host=localhost;Port=5432;Database=school_admission;Username=sas;Password=sas_dev_password;Maximum Pool Size=50
HOLD_DURATION_SECONDS=600
EXPIRY_SWEEP_INTERVAL_SECONDS=5
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Copy to `.env` (next to docker-compose.yml) to override defaults. Every variable is optional.
# Keep comments on their own lines: some dotenv parsers treat trailing text as part of the value.

# ---- PostgreSQL ----
POSTGRES_DB=school_admission
POSTGRES_USER=sas
POSTGRES_PASSWORD=sas_dev_password
# Host port for direct DB access
POSTGRES_PORT=5432
# Connection budget (decision D14)
POSTGRES_MAX_CONNECTIONS=200

# ---- Backend API (http://localhost:8080) ----
# How long a seat stays on HOLD before it expires
HOLD_DURATION_SECONDS=600
# How often expired holds are returned to the pool
EXPIRY_SWEEP_INTERVAL_SECONDS=5
# Max DB connections per backend instance (decision D14)
DB_POOL_SIZE=50
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080
